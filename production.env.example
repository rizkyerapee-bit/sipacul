# Salin file ini menjadi .env.production dan ganti semua nilai REPLACE_ME.
# .env.production diabaikan Git; jangan commit kredensial produksi.

POSTGRES_DB=sipacul
POSTGRES_USER=sipacul
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

SIPACUL_BOOTSTRAP_OWNER_TOKEN=REPLACE_ME_WITH_A_LONG_RANDOM_BOOTSTRAP_TOKEN

# Public activation tetap disabled secara default. Jangan ubah menjadi enabled
# sebelum domain, DNS, certificate, dan firewall host siap.
SIPACUL_PUBLIC_ACTIVATION=disabled
SIPACUL_PUBLIC_HOSTNAME=_
SIPACUL_HSTS_ENABLED=false
SIPACUL_HSTS_MAX_AGE=86400

# Default tetap loopback. Public activation mewajibkan bind non-loopback dan
# port HTTPS host 443 setelah seluruh activation gate lulus.
SIPACUL_BIND_ADDRESS=127.0.0.1
SIPACUL_HTTPS_PORT=8443

# Pilih subnet private /24 yang tidak bertabrakan pada host. IP edge harus
# berada di subnet itu dan tidak boleh dipakai container atau host lain.
SIPACUL_APPLICATION_SUBNET=10.240.20.0/24
SIPACUL_EDGE_IP=10.240.20.10

# File PEM milik deployment; jangan simpan sertifikat atau private key di Git.
# Private key host tetap root:root; edge membacanya sebagai UID 101:GID 0.
SIPACUL_TLS_CERTIFICATE_PATH=REPLACE_ME_WITH_ABSOLUTE_TLS_CERTIFICATE_PEM_PATH
SIPACUL_TLS_PRIVATE_KEY_PATH=REPLACE_ME_WITH_ABSOLUTE_TLS_PRIVATE_KEY_PEM_PATH

# Default lokal dipertahankan untuk build/test lokal. Deployment yang memakai
# Sprint 20D2G1 harus mengganti ke empat GHCR image dari full Git SHA yang sama:
# ghcr.io/<owner>/sipacul-<component>:sha-<40-character-git-sha>
SIPACUL_MIGRATOR_IMAGE=sipacul-migrator:local
SIPACUL_API_IMAGE=sipacul-api:local
SIPACUL_FRONTEND_IMAGE=sipacul-frontend:local
SIPACUL_EDGE_IMAGE=sipacul-edge:local
